#!/bin/bash
# ==============================================================================
# config.env -- Centralized HPC Configuration (UC Berkeley Savio)
# ==============================================================================
#
# Edit this file ONCE with your Savio-specific settings. All SLURM scripts and
# wrapper scripts in this project source this file so you only configure once.
#
# INSTRUCTIONS: Replace every value marked "CHANGE_ME" with your actual setting.
#
# Savio partitions reference (https://docs-research-it.berkeley.edu/services/high-performance-computing/user-guide/hardware-config/):
#   savio4_htc   -- 212 nodes, per-core CPU, 56 cores/node, 256 or 512 GB RAM
#                   (~4.6-9.1 GB/core depending on node)
#   savio4_gpu   -- 26 nodes w/ 8x RTX A5000 (24 GB, 4:1 CPU:GPU, 32 cores)
#                    3 nodes w/ 8x L40 (46 GB, 8:1 CPU:GPU, 64 cores)
#   Memory is allocated proportional to cores -- do NOT use --mem on Savio.
# ==============================================================================

# ---------- SLURM / Scheduler ----------
export HPC_PARTITION="savio4_htc"          # CPU partition for data prep / Kallisto
export HPC_GPU_PARTITION="savio4_gpu"      # GPU partition for training
export HPC_EMAIL="rishal_misra@berkeley.edu"               # Your email for SLURM notifications
export HPC_ACCOUNT="pc_disconasabio"             # Required on Savio, e.g. "fc_bioinf"

# ---------- Resource Defaults ----------
export KALLISTO_CPUS=2                     # CPUs per Kallisto task (~9-18 GB on savio4_htc)
export PREPROCESS_CPUS=16                  # CPUs for ARCHS4 preprocessing (~74-146 GB on savio4_htc)
export TRAIN_CPUS=4                        # CPUs per GPU process (4:1 CPU:GPU on A5000 nodes)
export NUM_GPUS=2                          # GPUs for DDP training (pretrain + finetune)
export GPU_TYPE="A5000"                    # A5000 (24 GB); change to "L40" for 46 GB VRAM (3 nodes)

# ---------- Conda ----------
# On Savio, run "module load anaconda3" before conda. CONDA_INIT_SCRIPT is for
# non-Savio clusters where you source conda.sh manually.
export CONDA_INIT_SCRIPT=""                # Leave empty on Savio (module load handles it)
export KALLISTO_ENV="kallisto_v0.51.1"     # Conda env name for Phase 1
export BIOFM_ENV="biofm"                  # Conda env name for Phases 2-4

# ---------- Project Paths (auto-detected, rarely need changing) ----------
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DATA_DIR="${PROJECT_ROOT}/data"
export KALLISTO_DIR="${PROJECT_ROOT}/01_kallisto_reprocessing"
export PRETRAIN_DIR="${PROJECT_ROOT}/03_pretrain_performer"
export FINETUNE_DIR="${PROJECT_ROOT}/04_finetune_osdr"
