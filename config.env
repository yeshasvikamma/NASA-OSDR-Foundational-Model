#!/bin/bash
# ==============================================================================
# config.env -- Centralized HPC Configuration
# ==============================================================================
#
# Edit this file ONCE with your HPC-specific settings. All SLURM scripts and
# wrapper scripts in this project source this file so you only configure once.
#
# INSTRUCTIONS: Replace every value marked "CHANGE_ME" with your actual setting.
# ==============================================================================

# ---------- SLURM / Scheduler ----------
export HPC_PARTITION="CHANGE_ME"           # e.g. "normal", "gpu", "batch"
export HPC_GPU_PARTITION="CHANGE_ME"       # GPU partition, e.g. "gpu", "a100"
export HPC_EMAIL="CHANGE_ME"               # Your email for SLURM notifications
export HPC_ACCOUNT=""                      # (optional) --account if required

# ---------- Resource Defaults ----------
export KALLISTO_MEM=18000                  # MB, for Kallisto jobs (can go as low as 12000)
export KALLISTO_CPUS=2                     # CPUs per Kallisto task (can go as low as 1)
export PREPROCESS_MEM=64000                # MB, for ARCHS4 preprocessing (needs RAM for HDF5)
export PREPROCESS_CPUS=8                   # CPUs for preprocessing
export TRAIN_MEM=64000                     # MB, for model training
export TRAIN_CPUS=8                        # CPUs for model training
export NUM_GPUS=2                          # GPUs for DDP training (pretrain + finetune)
export GPU_TYPE=""                         # (optional) e.g. "a100", "v100" for --gres

# ---------- Conda ----------
export CONDA_INIT_SCRIPT=""                # Path to conda.sh if needed, e.g. "$HOME/miniconda3/etc/profile.d/conda.sh"
export KALLISTO_ENV="kallisto_v0.51.1"     # Conda env name for Phase 1
export BIOFM_ENV="biofm"                  # Conda env name for Phases 2-4

# ---------- Project Paths (auto-detected, rarely need changing) ----------
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DATA_DIR="${PROJECT_ROOT}/data"
export KALLISTO_DIR="${PROJECT_ROOT}/01_kallisto_reprocessing"
export PRETRAIN_DIR="${PROJECT_ROOT}/03_pretrain_performer"
export FINETUNE_DIR="${PROJECT_ROOT}/04_finetune_osdr"
